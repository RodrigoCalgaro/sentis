<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Desconectado"
        android:textStyle="bold"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <EditText
            android:id="@+id/hostInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="192.168.4.1"
            android:inputType="text" />

        <EditText
            android:id="@+id/portInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="3333"
            android:inputType="number" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conectar" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Ajustes"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/volumeValueText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Volumen: 70%" />

    <SeekBar
        android:id="@+id/volumeSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:min="0"
        android:max="100"
        android:progress="70" />

    <TextView
        android:id="@+id/warnValueText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Umbral precaución: 1500 mm" />

    <SeekBar
        android:id="@+id/warnSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:min="300"
        android:max="4000"
        android:progress="1500" />

    <TextView
        android:id="@+id/alertValueText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Umbral alerta: 500 mm" />

    <SeekBar
        android:id="@+id/alertSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:min="100"
        android:max="2000"
        android:progress="500" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/startReadingButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="leer (manual, 6)" />

        <Button
            android:id="@+id/stopReadingButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="parar (manual, 7)" />

        <Button
            android:id="@+id/detectColorButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="detectar color (manual, 8)" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <EditText
            android:id="@+id/ocrTextInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="texto reconocido (OCR)" />

        <Button
            android:id="@+id/ocrReplyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Responder OCR" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Audio recibido:" />

    <TextView
        android:id="@+id/audioStatsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 chunks, 0 bytes" />

    <TextView
        android:id="@+id/voiceStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Vosk: sin iniciar" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Último frame recibido (OCR o color):" />

    <ImageView
        android:id="@+id/ocrPreviewImage"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="4dp"
        android:background="#DDDDDD"
        android:scaleType="fitCenter"
        android:contentDescription="Último frame capturado para OCR o detección de color" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </ScrollView>

</LinearLayout>
